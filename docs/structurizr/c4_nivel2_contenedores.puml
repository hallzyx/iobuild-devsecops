@startuml
title <size:24>Container View: IoBuild Platform</size>\n<size:18>Nivel 2: Contenedores del Sistema IoBuild Platform</size>

set separator none
left to right direction

<style>
  root {
    BackgroundColor: #ffffff
    FontColor: #444444
  }
</style>

!include <C4/C4>
!include <C4/C4_Container>

SHOW_PERSON_OUTLINE()

Person(AdministradordeCondominios, "Administrador de Condominios", $descr="Property Manager B2B que configura catastro y aprueba liquidaciones.")
Person(PropietarioResidente, "Propietario / Residente", $descr="Copropietario B2C que visualiza consumos y paga cuotas.")

System_Boundary(c1, "IoBuild Platform") {
    Container(LandingPage, "Landing Page", "HTML / CSS / JS", "Sitio web público de marketing y captación comercial.")
    Container(WebSPAPortal, "Web SPA Portal", "Vue 3, Vite, PrimeVue", "Portal web responsivo para gestión catastral y pagos.")
    Container(MobileApp, "Mobile App", "Android, Kotlin", "App móvil nativa para copropietarios y chat con copiloto IA.")
    Container(Nginx, "Nginx (Reverse Proxy)", "Nginx / Alpine", "Proxy inverso en puerto 8081/80; sirve estáticos y redirige a /api.")
    Container(APIMonolito, "API Monolito (IoBuild.Api)", "ASP.NET Core 9, C#", "Backend modular: IAM, Cadastre, Subscriptions, Proration, Telemetry y AI.")
    ContainerDb(MySQLDatabase, "MySQL Database", "MySQL 8.0", "Instancia centralizada con volumen persistente para todas las tablas relacionales.")
    ContainerQueue(Mosquitto, "Mosquitto (MQTT Broker)", "Eclipse Mosquitto", "Broker pub/sub para ingesta asíncrona de telemetría y eventos de consumo.")
}

System_Ext(Stripe, "Stripe Payments Platform", "Pasarela de pagos para suscripciones y cuotas con tarjeta.")
SystemDb_Ext(Cloudinary, "Cloudinary CDN", "Custodia y optimización de comprobantes bancarios y fotos.")
System_Ext(Gemini, "Google Gemini / OpenAI API", "Modelos LLM para RAG y diagnóstico conversacional.")

Rel(AdministradordeCondominios, LandingPage, "Visita para conocer plataforma", "HTTPS")
Rel(LandingPage, WebSPAPortal, "Redirige a portal", "HTTPS")
Rel(AdministradordeCondominios, WebSPAPortal, "Ingreso a gestión y catastro", "HTTPS")
Rel(PropietarioResidente, WebSPAPortal, "Consulta cuentas y realiza pagos", "HTTPS")
Rel(PropietarioResidente, MobileApp, "Consulta consumos y chat IA", "Android UI")

Rel(WebSPAPortal, Nginx, "Peticiones /api", "HTTPS")
Rel(MobileApp, Nginx, "Peticiones /api", "HTTPS")
Rel(Nginx, WebSPAPortal, "Sirve archivos SPA", "HTTP")
Rel(Nginx, APIMonolito, "Proxy inverso a :8080", "HTTP")

Rel(APIMonolito, MySQLDatabase, "Lectura y persistencia relacional", "MySQL :3306")
Rel(APIMonolito, Mosquitto, "Suscripción a telemetría y eventos", "MQTT :1883")

Rel(WebSPAPortal, Stripe, "Redirige a checkout", "HTTPS / Stripe.js")
Rel(APIMonolito, Stripe, "Crea sesiones checkout y webhooks", "HTTPS / REST")
Rel(APIMonolito, Cloudinary, "Guarda fotos y comprobantes", "HTTPS / REST")
Rel(APIMonolito, Gemini, "Inferencia LLM y RAG", "HTTPS / REST")

SHOW_LEGEND(true)
hide stereotypes
@enduml