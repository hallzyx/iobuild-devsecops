@startuml
title <size:24>Component View: API Monolito (IoBuild.Api)</size>\n<size:18>Nivel 3: Componentes del API Monolito</size>

set separator none
top to bottom direction

<style>
  root {
    BackgroundColor: #ffffff
    FontColor: #444444
  }
</style>

!include <C4/C4>
!include <C4/C4_Component>

Container(Nginx, "Nginx (Reverse Proxy)", "Nginx / Alpine", "Proxy inverso receptor de tráfico HTTP en :8081")

Container_Boundary(api_boundary, "API Monolito (IoBuild.Api)") {
    Component(iamModule, "Módulo IAM", "ASP.NET Core", "Autenticación, hashing BCrypt, emisión de JWT y control de roles.")
    Component(cadastreModule, "Módulo Cadastre & Units", "ASP.NET Core", "Catastro físico de edificios, unidades inmobiliarias y padrón de alícuotas.")
    Component(devModule, "Módulo Units & Devices", "ASP.NET Core", "Asociación y registro de medidores por departamento y parámetros de medición.")
    Component(telemetryModule, "Módulo Telemetry & Analytics", "ASP.NET Core", "Procesamiento de lecturas, agregaciones horarias y consumos históricos.")
    Component(prorationModule, "Módulo Proration (Core)", "ASP.NET Core", "Motor matemático de distribución de gastos comunes según alícuotas.")
    Component(subModule, "Módulo Subscriptions", "ASP.NET Core", "Planes SaaS B2B, facturación y procesamiento de webhooks Stripe.")
    Component(aiModule, "Módulo AiAssistant (RAG)", "ASP.NET Core", "Copiloto conversacional: inyección de contexto RAG y diagnóstico.")
    Component(persistenceModule, "Módulo Persistence", "Entity Framework Core 9", "Unit of Work centralizado, mapeo relacional de entidades y transacciones ACID.")
}

ContainerDb(database, "MySQL Database", "MySQL 8.0", "Instancia de base de datos relacional centralizada.")
ContainerQueue(mosquitto, "Mosquitto (MQTT Broker)", "Eclipse Mosquitto", "Broker MQTT para ingesta de eventos de consumo.")
System_Ext(stripe, "Stripe Payments Platform", "Pasarela de pagos externos.")
SystemDb_Ext(cloudinary, "Cloudinary CDN", "Custodia multimedia de comprobantes.")
System_Ext(gemini, "Google Gemini / OpenAI API", "Modelos LLM para inferencia RAG.")

Rel(Nginx, iamModule, "Enruta /api/v1/auth", "HTTP")
Rel(Nginx, cadastreModule, "Enruta /api/v1/cadastre", "HTTP")
Rel(Nginx, devModule, "Enruta /api/v1/devices", "HTTP")
Rel(Nginx, telemetryModule, "Enruta /api/v1/telemetry", "HTTP")
Rel(Nginx, prorationModule, "Enruta /api/v1/proration", "HTTP")
Rel(Nginx, subModule, "Enruta /api/v1/subscriptions", "HTTP")
Rel(Nginx, aiModule, "Enruta /api/v1/ai-chat", "HTTP")

Rel(iamModule, persistenceModule, "Gestiona usuarios")
Rel(cadastreModule, persistenceModule, "Gestiona edificios y alícuotas")
Rel(devModule, persistenceModule, "Gestiona medidores")
Rel(telemetryModule, persistenceModule, "Gestiona consumos históricos")
Rel(prorationModule, persistenceModule, "Gestiona liquidaciones")
Rel(subModule, persistenceModule, "Gestiona membresías")

Rel(persistenceModule, database, "Queries y transacciones ACID", "MySQL :3306")

Rel(telemetryModule, mosquitto, "Consume eventos de telemetría", "MQTT :1883")
Rel(subModule, stripe, "Valida pagos y membresías", "HTTPS / REST")
Rel(aiModule, gemini, "Inferencia multimodal RAG", "HTTPS / REST")
Rel(aiModule, persistenceModule, "Consulta contexto histórico RAG")

SHOW_LEGEND(true)
hide stereotypes
@enduml