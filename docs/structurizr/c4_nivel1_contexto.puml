@startuml
title <size:24>System Context View: IoBuild Platform</size>\n<size:18>Nivel 1: Contexto del Sistema IoBuild Platform</size>

set separator none
left to right direction

<style>
  root {
    BackgroundColor: #ffffff
    FontColor: #444444
  }
</style>

!include <C4/C4>
!include <C4/C4_Context>

SHOW_PERSON_OUTLINE()

Person(AdministradordeCondominios, "Administrador de Condominios", $descr="Segmento Objetivo B2B: Property Manager que configura catastro, valida alícuotas, aprueba liquidaciones y supervisa cobros.")
Person(PropietarioResidente, "Propietario / Residente", $descr="Segmento Objetivo B2C: Copropietario que visualiza consumos en tiempo real, abona cuotas con tarjeta y consulta al asistente IA.")

System(IoBuildPlatform, "IoBuild Platform", $descr="Plataforma central SaaS/HaaS para gestión de condominios: cálculo de alícuotas, liquidación matemática de gastos comunes, pasarela de cobros y copiloto cognitivo RAG.")

System_Ext(StripePaymentsPlatform, "Stripe Payments Platform", $descr="Pasarela de pagos para planes de suscripción B2B y recaudación B2C con tarjeta.")
SystemDb_Ext(CloudinaryCDN, "Cloudinary CDN", $descr="Custodia y optimización de comprobantes bancarios escaneados y fotos de incidencias.")
System_Ext(GoogleGeminiOpenAIAPI, "Google Gemini / OpenAI API", $descr="Modelos fundacionales LLM para análisis RAG, soporte en lenguaje natural y explicabilidad matemática.")

Rel(AdministradordeCondominios, IoBuildPlatform, "Gestiona catastro y liquidaciones", $techn="HTTPS / Web Portal")
Rel(PropietarioResidente, IoBuildPlatform, "Visualiza consumos y paga cuotas", $techn="HTTPS / Mobile App y Web")

Rel(IoBuildPlatform, StripePaymentsPlatform, "Procesa cargos de suscripción y recibos", $techn="REST / HTTPS")
Rel(IoBuildPlatform, CloudinaryCDN, "Almacena y optimiza vouchers y fotos", $techn="REST / HTTPS")
Rel(IoBuildPlatform, GoogleGeminiOpenAIAPI, "Inyecta contexto RAG y recibe inferencias", $techn="REST / HTTPS")

SHOW_LEGEND(true)
hide stereotypes
@enduml