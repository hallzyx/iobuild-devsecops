  "tests": [
    {
      "id": "06159bd1-88a9-50db-aa18-b65a1e656743",
      "name": "IAM login: wrong credentials give a generic error",
      "commands": [
        {
          "id": "9a72738a-244d-52c3-9b29-9221d3e8e612",
          "comment": "Unique suffix so each run registers a new account",
          "command": "executeScript",
          "target": "return String(Date.now())",
          "targets": [],
          "value": "stamp"
        },
        {
          "id": "a725f9de-570d-5ceb-9987-d888c9a91b0b",
          "comment": "",
          "command": "executeScript",
          "target": "return String(Date.now()).slice(-6)",
          "targets": [],
          "value": "suffix"
        },
        {
          "id": "8a5360e8-44e3-5f59-a3a8-592a2e7ca139",
          "comment": "Start clean: drop any session left by a previous test",
          "command": "open",
          "target": "/",
          "targets": [],
          "value": ""
        },
        {
          "id": "566bd8f1-4279-5fbc-a2dd-6368d29812f5",
          "comment": "",
          "command": "executeScript",
          "target": "localStorage.clear(); sessionStorage.clear(); return true",
          "targets": [],
          "value": "cleared"
        },
        {
          "id": "102768f6-5bc4-5a75-b8d9-fa52b892cb57",
          "comment": "",
          "command": "setWindowSize",
          "target": "1280x900",
          "targets": [],
          "value": ""
        },
        {
          "id": "0168818d-c28a-50c8-8de2-a53c6344f905",
          "comment": "",
          "command": "open",
          "target": "/iam/login",
          "targets": [],
          "value": ""
        },
        {
          "id": "b86399fc-4a0f-5800-9712-75424b3a3d53",
          "comment": "",
          "command": "waitForElementVisible",
          "target": "id=email",
          "targets": [],
          "value": "20000"
        },
        {
          "id": "63fadc80-b793-5909-b64d-f11bde57b00a",
          "comment": "",
          "command": "type",
          "target": "id=email",
          "targets": [],
          "value": "nobody.${stamp}@example.test"
        },
        {
          "id": "0561b0e0-7db2-52fd-b15b-777a4e02418f",
          "comment": "",
          "command": "type",
          "target": "css=#password input",
          "targets": [],
          "value": "wrong-password"
        },
        {
          "id": "e68a4e75-f17d-53b1-bd2d-c8f01cda407c",
          "comment": "",
          "command": "click",
          "target": "css=button[type='submit']",
          "targets": [],
          "value": ""
        },
        {
          "id": "1b7c0175-c714-5ac8-8149-863f1f912a59",
          "comment": "",
          "command": "waitForElementVisible",
          "target": "xpath=//*[normalize-space()='Correo o contraseña incorrectos.']",
          "targets": [],
          "value": "20000"
        },
        {
          "id": "7be08940-6e85-5271-a1f9-652cfa7d9106",
          "comment": "No field is blamed",
          "command": "assertElementNotPresent",
          "target": "css=.p-error",
          "targets": [],
          "value": ""
        },
        {
          "id": "d923de87-6adb-53d9-b34f-880b7a913e5c",
          "comment": "",
          "command": "executeScript",
          "target": "return window.location.pathname",
          "targets": [],
          "value": "path"
        },
        {
          "id": "1be74034-8908-5173-8908-5a773e2db692",
          "comment": "",
          "command": "assert",
          "target": "path",
          "targets": [],
          "value": "/iam/login"
        }
      ]
    },
